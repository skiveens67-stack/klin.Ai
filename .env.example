NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://klin.website

# Server-only Supabase key. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Klin's Stripe account only. Do not use another project's Stripe credentials.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_KLIN_TEST_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_KLIN_WEBHOOK_SECRET
STRIPE_PRICE_GALAXY=price_REPLACE_WITH_KLIN_GALAXY_PRICE
STRIPE_PRICE_STUDIO_PRO=price_REPLACE_WITH_KLIN_STUDIO_PRO_PRICE
STRIPE_PRICE_ULTIMATE=price_REPLACE_WITH_KLIN_ULTIMATE_PRICE
STRIPE_PRICE_BUILDER_STARTER=price_REPLACE_WITH_KLIN_BUILDER_STARTER_PRICE
STRIPE_PRICE_BUILDER_PRO=price_REPLACE_WITH_KLIN_BUILDER_PRO_PRICE
STRIPE_PRICE_BUILDER_BUSINESS=price_REPLACE_WITH_KLIN_BUILDER_BUSINESS_PRICE

# Gems pack price IDs and corresponding credit amounts. Configure only after pricing approval.
STRIPE_PRICE_GEMS_1000=price_REPLACE_WITH_KLIN_GEMS_1000_PRICE
KLIN_GEMS_AMOUNT_1000=1000
STRIPE_PRICE_GEMS_5000=price_REPLACE_WITH_KLIN_GEMS_5000_PRICE
KLIN_GEMS_AMOUNT_5000=5000
STRIPE_PRICE_GEMS_10000=price_REPLACE_WITH_KLIN_GEMS_10000_PRICE
KLIN_GEMS_AMOUNT_10000=10000

# Encryption key: base64-encoded 32-byte key. Required before storing contact destinations.
KLIN_CONTACT_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Klinie AI via Vercel AI Gateway. Keep both values server-only.
# Select a current provider/model ID from https://ai-gateway.vercel.sh/v1/models.
AI_GATEWAY_API_KEY=REPLACE_WITH_KLIN_AI_GATEWAY_KEY
KLINIE_MODEL=REPLACE_WITH_PROVIDER_MODEL_ID
# Optional per-tier model routing. Values must be valid current Vercel AI Gateway model IDs.
# V1 falls back to KLINIE_MODEL; V2-V7 fail closed until configured.
KLIN_MODULE_V2_MODEL=
KLIN_MODULE_V3_MODEL=
KLIN_MODULE_V4_MODEL=
KLIN_MODULE_V5_MODEL=
KLIN_MODULE_V6_MODEL=
KLIN_MODULE_V7_MODEL=
